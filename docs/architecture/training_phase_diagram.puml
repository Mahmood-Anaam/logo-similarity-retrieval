
@startuml
skinparam style strict
skinparam shadowing false
skinparam rectangle {
  FontSize 12
  FontName "Arial"
  RoundCorner 10
  BackgroundColor White
}

skinparam defaultTextAlignment center
left to right direction
title Training Phase: Logo Recognition and Similarity Retrieval

skinparam package {
  BackgroundColor #F9F9F9
  BorderColor Black
}



package "Training Phase (Offline Only)" <<Training>> {
  rectangle Data as "Synthetic Logo Dataset\n(Images + Text Prompts)"
  rectangle VisEncoder as "ResNet50 Encoder\n2048-D Visual Embedding"
  rectangle TextEncoder as "MiniLM Encoder\n384-D Text Embedding"
  rectangle Fusion as "Multimodal Fusion\n2432-D Embedding"
  rectangle UMAP as "UMAP Reduction\n2432-D → 600-D"
  rectangle Clustering as "HDBSCAN Clustering\n→ Pseudo-Categories"
  rectangle TripletGen as "Triplet Generator\nAnchor / Positive / Negative"
  rectangle TripletNetTrain as "TripletNet Training\nOutput: 256-D Embedding"
   
  Data -down-> VisEncoder
  Data -down-> TextEncoder
  VisEncoder -down-> Fusion
  TextEncoder -down-> Fusion
  Fusion -down-> UMAP
  UMAP -down-> Clustering
  Clustering -down-> TripletGen
  TripletGen -down-> TripletNetTrain
}
@enduml
